# ── Build output ──────────────────────────────────────────────────────────────
/target/
/target-*/
/plugins/target/
/dist/
/corpus/
/log/

# ── Logs and profiles ────────────────────────────────────────────────────────
*.log
*.profraw

# ── Editors and OS ───────────────────────────────────────────────────────────
.DS_Store
*~
.idea/
.vscode/
.cache/

# ── Reference copies, excluded from the workspace build ───────────────────────
# The immediate-mode front-end is the reference the GPUI port is checked against; the two legacy
# app shells are kept for that comparison. They are tracked, but `Cargo.toml` excludes them from
# the workspace, so they are neither built nor released by this repository.
/crates/ui-egui/
/apps/figcraft/
/apps/figcraft-web/

# ── Scratch, plans and agent files ───────────────────────────────────────────
/.tmp/
plan/
plans/
.workbuddy-ai/
.workbuddy/memory/
/_base_lib.rs
/_lib_render_cut_backup.rs
/_render_base.rs

# ── Development screenshots and source excerpts ──────────────────────────────
# Regenerated on demand; the excerpts are read from crates/ui-egui.
/crates/ui-gpui/*.png
/shot_*.png
/crop_*.png
/crates/ui-gpui/src/panels/right/reference/

# Agent scratch / debug captures
/.tmp_shots/
/.workbuddy/
/.tmp_*.txt
