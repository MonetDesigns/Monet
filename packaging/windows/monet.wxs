<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <?ifndef HasCraftFontLicences ?>
  <?define HasCraftFontLicences=0 ?>
  <?endif?>
  <Package Name="Monet" Manufacturer="Learning Machines LLC" Version="$(var.Version)" UpgradeCode="7F8B9827-D065-41B7-A514-2A454B21F484" Scope="perUserOrMachine" Compressed="yes" Language="1033">
    <SummaryInformation Description="Monet interface design and prototyping tool" Manufacturer="Learning Machines LLC" />
    <?include $(sys.SOURCEFILEDIR)install-policy.wxi?>
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of Monet is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- MSI caches this icon using its Id as the filename. Advertised shortcuts to an
         .exe need an .exe icon identifier (ICE50), even when the source is an ICO. -->
    <Icon Id="MonetIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="MonetIcon.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/MonetDesigns/Monet" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/MonetDesigns/Monet/releases" />
    <Property Id="ARPHELPLINK" Value="https://github.com/MonetDesigns/Monet/discussions" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Monet" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- An upgrade installs where the user put the previous version (written by MonetApp). -->

    <Feature Id="Main" Title="Monet" Level="1">
      <?if $(var.HasCraftFontLicences) = 1 ?>
      <ComponentGroupRef Id="CraftFontLicences" />
      <?endif?>
      <ComponentGroupRef Id="MonetFiles" />
    </Feature>

    <!-- The setup wizard: WixUI_InstallDir without its licence page (the code is MIT OR
         Apache-2.0; there is nothing to accept). A later NewDialog on the same button wins. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchMonet" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <!-- Our own art, generated by package.ps1 from the app icon (not WiX's stock bitmaps). -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />

    <!-- The full version (Version is numeric, so it drops a pre-release tag), shown on the wizard's
         pages through monet.en-us.wxl. -->
    <Property Id="MonetVersion" Value="$(var.DisplayVersion)" />

    <!-- Finish page: say where to find the app, and offer to start it (ticked by default). -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="Monet $(var.DisplayVersion) is installed. You can start it any time from the Start menu." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Monet" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#MonetExe]" />
    <!-- Runs in the wizard's own (unelevated) process, so the app starts as the user, not as admin. -->
    <CustomAction Id="LaunchMonet" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Package>

  <Fragment>
    <?if $(var.HasCraftFontLicences) = 1 ?>
    <ComponentGroup Id="CraftFontLicences" Directory="INSTALLFOLDER">
      <Files Include="$(var.DocsDir)\**" />
    </ComponentGroup>
    <?endif?>
    <ComponentGroup Id="MonetFiles" Directory="INSTALLFOLDER">
      <Component Id="MonetApp" Guid="238228C3-4C1D-4B33-8C5D-C31B65BC2DA4">
        <File Id="MonetNotice" Source="$(var.BinDir)\NOTICE" KeyPath="no" />
        <File Id="MonetExe" Source="$(var.BinDir)\monet.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Monet" Description="Monet interface design and prototyping" WorkingDirectory="INSTALLFOLDER" Advertise="yes" Icon="MonetIcon.exe" IconIndex="0" />
        </File>

        <!-- .figcraft: Monet's own format; Monet is its default app. -->
        <ProgId Id="Monet.Document" Description="Monet Document" Icon="MonetExe" IconIndex="0">
          <Extension Id="figcraft" ContentType="application/x-figcraft">
            <Verb Id="open" Command="Open" TargetFile="MonetExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <!-- SVG and images: offered under "Open with", never forced as the default. -->
        <ProgId Id="Monet.Image" Description="Image" Icon="MonetExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Monet.Image\shell\open\command" Value="&quot;[#MonetExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.svg\OpenWithProgids" Name="Monet.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.png\OpenWithProgids" Name="Monet.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.jpg\OpenWithProgids" Name="Monet.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.jpeg\OpenWithProgids" Name="Monet.Image" Value="" Type="string" />
        <!-- Sketch files (opened as a copy; Monet doesn't save .sketch): "Open with" only too. -->
        <ProgId Id="Monet.Sketch" Description="Sketch Document" Icon="MonetExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Monet.Sketch\shell\open\command" Value="&quot;[#MonetExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.sketch\OpenWithProgids" Name="Monet.Sketch" Value="" Type="string" />

        <!-- "Open with" app list and the Run dialog (Win+R "monet"). -->
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\monet.exe" Name="FriendlyAppName" Value="Monet" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\monet.exe\shell\open\command" Value="&quot;[#MonetExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\monet.exe\SupportedTypes" Name=".figcraft" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\monet.exe\SupportedTypes" Name=".svg" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\monet.exe\SupportedTypes" Name=".png" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\monet.exe\SupportedTypes" Name=".jpg" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\monet.exe\SupportedTypes" Name=".jpeg" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\monet.exe\SupportedTypes" Name=".sketch" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\monet.exe" Value="[#MonetExe]" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Monet" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

<?if $(var.HasCli) = 1 ?>
      <Component Id="MonetCli">
        <File Id="MonetCliExe" Source="$(var.BinDir)\monet-cli.exe" KeyPath="yes" />
      </Component>
<?endif?>
    </ComponentGroup>
  </Fragment>
</Wix>
